# ============================================================
# ZT Lounge Public Website - Environment Variables
# Copy to .env.local and fill in values. NEVER commit .env.local.
#
# This static site has no build step. At deploy time, inject these
# values into the browser via window.__SUPABASE_CONFIG (see
# assets/js/config/env.js).
# ============================================================

# Supabase Project URL
# Get from: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (safe for browser). NEVER put the service_role key here.
# Get from: Supabase Dashboard → Settings → API → Project API Keys → anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ============================================================
# NOTES
# 1. The anon key is public and safe to ship to the browser.
# 2. The service_role key has admin privileges - NEVER expose it
#    to the browser, commit it to this repo, or put it here.
# 3. The website and zt-lounge-admin must point to the SAME
#    Supabase project.
# ============================================================