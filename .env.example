# ============================================================
# ZT Lounge Public Website - Environment Variables
# Copy to .env.local and fill in values. NEVER commit .env.local.
#
# This static site has no build step. At deploy time, inject these
# values into the browser via window.__SUPABASE_CONFIG (see
# assets/js/config/env.js). The values below are the live project
# defaults shared with zt-lounge-admin.
# ============================================================

# Supabase Project URL (live project ref: jczwilrysvnhcjzjztbi)
NEXT_PUBLIC_SUPABASE_URL=https://jczwilrysvnhcjzjztbi.supabase.co

# Public anon key (safe for browser). NEVER put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpjendpbHJ5c3ZuaGNqemp6dGJpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM5NDEyNTAsImV4cCI6MjA5OTUxNzI1MH0.TooU0gjA4VcKsGBF07O1hpiCvJgACLxvZY09bukpXhw

# ============================================================
# NOTES
# 1. The anon key is public and safe to ship to the browser.
# 2. The service_role key has admin privileges - NEVER expose it
#    to the browser or commit it to this repo.
# 3. The website and zt-lounge-admin must point to the SAME
